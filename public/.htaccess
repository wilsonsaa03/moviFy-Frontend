<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Nunca servir: archivos ocultos (.git, .env), mapas de código, respaldos, volcados de BD ni código fuente.
  # Se excluye .well-known (lo usa Let's Encrypt para renovar el certificado).
  # (Con mod_rewrite y no con Options/Require: esas exigen permisos de AllowOverride que el VPS puede no dar.)
  RewriteRule ^\.well-known/ - [L]
  RewriteRule (^|/)\. - [F,L]
  RewriteRule \.(map|bak|old|orig|sql|zip|tar|gz|log|ini|env|properties|ya?ml|sh|ts)$ - [F,NC,L]
  # Sin listado de carpetas (p. ej. /assets/)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^.+$ - [F,L]

  # Siempre HTTPS (también si Apache está detrás de otro proxy que ya terminó el TLS)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # El navegador solo vuelve a entrar por HTTPS durante un año
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Política de contenido (protección contra XSS): solo se ejecuta código de MoviFY y de los
  # proveedores que la web usa, con versión fija (Chart.js, mapa de rutas, login de Google).
  #   - Imágenes de cualquier https: fotos de Google, íconos, mapas de OpenStreetMap.
  #   - 'unsafe-inline' solo en estilos (Angular y Leaflet ponen estilos en línea; no ejecutan código).
  # Si se agrega un servicio externo nuevo hay que sumarlo aquí o el navegador lo bloqueará.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client https://cdn.jsdelivr.net/npm/chart.js@4.4.0/ https://unpkg.com/leaflet-routing-machine@3.2.12/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style https://unpkg.com/leaflet-routing-machine@3.2.12/; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://router.project-osrm.org https://nominatim.openstreetmap.org https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

  # Nadie puede meter la web en un iframe (clickjacking)
  Header always set X-Frame-Options "DENY"
  # El navegador no adivina tipos de archivo (un .txt subido nunca se ejecuta como script)
  Header always set X-Content-Type-Options "nosniff"
  # Los enlaces de recuperación (?token=...) no se filtran a otros sitios por el Referer
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Permisos del navegador: solo la ubicación (pedir viaje, conductor); nada de cámara, micrófono ni pagos
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
  # Aísla la ventana; "allow-popups" para que funcione la ventana de "Entrar con Google"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  # No anunciar versiones del servidor
  Header always unset X-Powered-By

  # index.html nunca en caché (así cada despliegue llega de inmediato); los .js/.css llevan hash y sí se cachean
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|png|jpg|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
